/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nfdata-omics/r2t2p -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 1,
        memory: '4.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input  = params.pipelines_testdata_base_path + 'R2T2P/DUX4_test/dux4_test.csv'
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    fasta = params.pipelines_testdata_base_path + 'refs/chr19/GRCh38.primary_assembly.chr19.fa.gz'
    gtf = params.pipelines_testdata_base_path + 'refs/chr19/gencode.v49.chr19.annotation.gtf.gz'
    user_provided_annotation = params.pipelines_testdata_base_path + 'refs/chr19/additional_annotation_chr19.gtf'
    control_label = "0h"
    go_package = "org.Hs.eg.db"
}
