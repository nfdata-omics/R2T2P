/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: '.*:PREPARE_REF:.*' {
        publishDir = [
            enabled: false
        ]
    }

    withName: ".*:PREPARE_REF:STAR_GENOMEGENERATE" {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ".*:PREPARE_FASTQ:.*" {
        publishDir = [
            enabled: false
        ]
    }

    withName: STAR_FIRST_ALIGN {
        ext.prefix = { meta.id + '.first_pass' }
        ext.args   =  """ --readFilesCommand zcat \
            --outFilterMismatchNmax 4 --outFilterMultimapNmax 250 \
            --chimScoreSeparation 10 --chimScoreMin 20 \
            --chimSegmentMin 15 --chimJunctionOverhangMin 10 \
            --outSAMattributes NH HI AS nM NM MD XS \
            --outSAMstrandField intronMotif --outSAMmultNmax 1 \
            --outMultimapperOrder Old_2.4 --twopassMode Basic \
            --alignSJstitchMismatchNmax 0 0 0 0 --outReadsUnmapped Fastx
        """
        publishDir = [
            [
                path: { "${params.outdir}/first_pass/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.{out,tab}'
            ],
            [
                path: { params.save_unaligned ? "${params.outdir}/first_pass/${meta.id}/unmapped" : params.outdir },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                saveAs: { params.save_unaligned ? it : null }
            ]
        ]
    }

    withName: ".*:FIRST_BAM_SORT_STATS:SAMTOOLS_SORT" {
        publishDir = [
            path: { "${params.outdir}/first_pass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ".*:FIRST_BAM_SORT_STATS:SAMTOOLS_INDEX" {
        publishDir = [
            path: { "${params.outdir}/first_pass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ".*:FIRST_BAM_SORT_STATS:BAM_STATS_SAMTOOLS:.*" {
        ext.prefix = { meta.id + '.first_pass' }
        publishDir = [
            path: { "${params.outdir}/first_pass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: STAR_WITH_NOVEL_JUNCT {
        ext.prefix = { meta.id + '.second_pass' }
        ext.args   =  """ --readFilesCommand zcat \
            --outFilterMismatchNmax 4 --outFilterMultimapNmax 250 \
            --chimScoreSeparation 10 --chimScoreMin 20 \
            --chimSegmentMin 15 --alignSJoverhangMin 500 \
            --outSAMattributes NH HI AS nM NM MD XS \
            --outSAMstrandField intronMotif --outSAMmultNmax 1 \
            --outMultimapperOrder Old_2.4 --limitSjdbInsertNsj 5000000 \
            --outReadsUnmapped Fastx
        """
        publishDir = [
            [
                path: { "${params.outdir}/second_pass/${meta.id}/" },
                mode: params.publish_dir_mode,
                pattern: '*.{out,tab}'
            ],
            [
                path: { params.save_unaligned ? "${params.outdir}/second_pass/${meta.id}/unmapped" : params.outdir },
                mode: params.publish_dir_mode,
                pattern: '*.fastq.gz',
                saveAs: { params.save_unaligned ? it : null }
            ]
        ]
    }

    withName: ".*:SECOND_BAM_SORT_STATS:SAMTOOLS_SORT" {
        publishDir = [
            path: { "${params.outdir}/second_pass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ".*:SECOND_BAM_SORT_STATS:SAMTOOLS_INDEX" {
        publishDir = [
            path: { "${params.outdir}/second_pass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: ".*:SECOND_BAM_SORT_STATS:BAM_STATS_SAMTOOLS:.*" {
        ext.prefix = { meta.id + '.second_pass' }
        publishDir = [
            path: { "${params.outdir}/second_pass/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: STRINGTIE {
        ext.args = '-m 100 --conservative -l R1'
    }

    withName: FILTER_UNDEFINED_STRAND {
        ext.args = '\'{if ($7!=".") print $0}\''
        ext.prefix = { meta.id + '.transcripts_with_strand' }
    }

    withName: ".*:MERGE_WITH_REF_ANNOTATION:GFFCOMPARE:.*" {
        ext.args = ''
    }

    withName: ".*:MERGE_WITH_REF_ANNOTATION:FILTER_UNDEFINED_STRAND:.*" {
        ext.args = '\'{if ($7!=".") print $0}\''
        ext.prefix = { meta.id + '_with_strand' }
    }

    withName: ".*:MERGE_WITH_USER_PROVIDED:FILTER_UNDEFINED_STRAND:.*" {
        ext.args = '\'{if ($7!=".") print $0}\''
        ext.prefix = { meta.id + '_with_strand' }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


}
